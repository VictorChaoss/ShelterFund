generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Campaign {
  id        String   @id @default(cuid())
  name      String
  shelter   String
  goal      Float
  raised    Float    @default(0)
  image     String
  createdAt DateTime @default(now())
  tokens    Token[]
  claims    Claim[]
}

model Token {
  id          String   @id @default(cuid())
  mintAddress String   @unique
  name        String
  ticker      String
  volumeUsd   Float    @default(0)
  createdAt   DateTime @default(now())
  
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
}

model Claim {
  id          String   @id @default(cuid())
  amountUsdc  Float
  walletTo    String
  txSignature String   @unique
  createdAt   DateTime @default(now())
  
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
}
